{
  "name": "sink-or-sail",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run && playwright test",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit && tsc -p e2e --noEmit",
    "build": "npm run build -w @sink-or-sail/client",
    "start": "npm run start -w @sink-or-sail/server",
    "test:unit": "vitest run",
    "test:smoke": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
